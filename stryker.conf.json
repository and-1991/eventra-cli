{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/plugin/builtins/configuredSinks.ts",
    "src/plugin/builtins/sinkPresets.ts",
    "src/cli/projectDependencies.ts",
    "src/cli/init.ts",
    "scripts/preset-packages-lib.ts",
    "src/plugin/registry.ts",
    "src/plugin/loadPlugins.ts",
    "src/core/scanFilters.ts",
    "src/core/fileLimits.ts",
    "src/core/skipped.ts",
    "src/core/catalogMeta.ts",
    "src/plugin/builtins/consoleDynamicEventReporter.ts",
    "src/analysis/shared/callSite.ts",
    "src/analysis/scanner/wrapperChains.ts",
    "src/analysis/scanner/analyzer/propagationAnalyzer.ts",
    "src/analysis/sdk/isEventraTrackCall.ts",
    "src/plugin/builtins/eventra-sdk.ts",
    "src/cli/check.ts:20-30",
    "src/cli/check.ts:68-71",
    "src/analysis/scanner/scanner.ts:40-50",
    "src/core/EventraEngine.ts:442-453"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 2,
  "timeoutMS": 120000,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
